{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "nodejs/**",
          "public/css/**",
          "public/js/**",
          "public/images/**",
          "public/fontawesome/**",
          "public/fonts/**",
          "public/icons/**",
          "public/manifest.webmanifest",
          "public/sw.js"
        ]
      }
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/js/kep.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
