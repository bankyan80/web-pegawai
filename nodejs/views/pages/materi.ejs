<% if (member && member.role != 'staff') { %>
  <% var ar_judul = ['No', 'Materi Pelatihan', 'Action']; %>
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h3 class="mb-0"><i class="fas fa-book text-primary mr-2"></i>Data Materi Pelatihan</h3>
    <a href="/?hal=form_materi" class="btn btn-primary"><i class="fas fa-plus mr-1"></i> Input Data</a>
  </div>
  <% if (rs.length === 0) { %>
    <div class="tm-empty">
      <i class="fas fa-inbox"></i>
      Belum ada data materi pelatihan.
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table tm-table table-hover">
        <thead>
          <tr>
            <% ar_judul.forEach(function(jdl) { %>
              <th scope="col"><%= jdl %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% var no = 1; %>
          <% rs.forEach(function(materi) { %>
            <tr>
              <th scope="row" class="row-head"><%= no %></th>
              <td><strong><%= materi.nama %></strong></td>
              <td>
                <a href="/?hal=form_materi&idedit=<%= materi.id %>" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Edit</a>
              </td>
            </tr>
            <% no++; %>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
<% } else { %>
  <%- include('../partials/denied') %>
<% } %>
