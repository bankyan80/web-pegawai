<% if (query.error) { %>
  <script>$(function(){ alert("Gagal Login"); $('#tmLoginModal').modal('show'); });</script>
<% } %>
<% if (query.blocked) { %>
  <script>$(function(){ alert("Terlalu banyak percobaan login. Silakan coba lagi 15 menit lagi."); $('#tmLoginModal').modal('show'); });</script>
<% } %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-7">
    <div class="tm-sambutan">
      <i class="fas fa-users fa-3x text-primary"></i>
      <h3 class="mt-3">Selamat Datang di Sistem Kepegawaian</h3>
      <p>
        Sistem Informasi Kepegawaian Tim Kerja Bidang Pendidikan Sekolah Dasar Kecamatan Lemahabang membantu Anda mengelola data pegawai, presensi, kepangkatan, gaji berkala, izin & cuti, diklat, serta seluruh layanan kepegawaian secara terpadu.
      </p>
      <p class="text-muted">Silakan login menggunakan tombol Login pada menu di atas untuk mulai mengakses seluruh layanan.</p>
    </div>
  </div>
</div>
