<% if (member) { %>
  <% var idedit = query.idedit || ''; %>
  <% var rs = typeof rs !== 'undefined' ? rs : {}; %>
  <% var ar_gender = { 'Laki-Laki': 'L', 'Perempuan': 'P' }; %>
  <h3><i class="fas fa-user-plus text-primary mr-2"></i><%= idedit ? 'Ubah Pegawai' : 'Tambah Pegawai' %></h3>
  <form method="POST" action="/controller/pegawai" class="mt-4">
    <input type="hidden" name="csrf_token" value="<%= csrf %>">
    <div class="row">
      <div class="col-md-6">
        <div class="form-group row">
          <label for="nip" class="col-4 col-form-label">NIP</label>
          <div class="col-8">
            <input id="nip" name="nip" type="text" value="<%= rs.nip || '' %>" class="form-control">
          </div>
        </div>
        <div class="form-group row">
          <label for="nama" class="col-4 col-form-label">Nama</label>
          <div class="col-8">
            <input id="nama" name="nama" value="<%= rs.nama || '' %>" type="text" class="form-control">
          </div>
        </div>
        <div class="form-group row">
          <label class="col-4">Gender</label>
          <div class="col-8">
            <% Object.keys(ar_gender).forEach(function(label) { %>
              <% var jk = ar_gender[label]; %>
              <% var cek = (jk == rs.gender) ? 'checked' : ''; %>
              <div class="form-check form-check-inline">
                <input name="gender" type="radio" <%= cek %> class="form-check-input" value="<%= jk %>">
                <label class="form-check-label"><%= label %></label>
              </div>
            <% }) %>
          </div>
        </div>
        <div class="form-group row">
          <label for="tmp" class="col-4 col-form-label">Tempat Lahir</label>
          <div class="col-8">
            <input id="tmp" name="tmp" value="<%= rs.tempat_lahir || '' %>" type="text" class="form-control">
          </div>
        </div>
        <div class="form-group row">
          <label for="tgl" class="col-4 col-form-label">Tanggal Lahir</label>
          <div class="col-8">
            <input id="tgl" name="tgl" value="<%= rs.tanggal_lahir || '' %>" type="date" class="form-control">
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group row">
          <label for="jabatan" class="col-4 col-form-label">Jabatan</label>
          <div class="col-8">
            <select id="jabatan" name="jabatan" class="custom-select">
              <option value="">-- Pilih Jabatan --</option>
              <% jabatanList.forEach(function(jab) { %>
                <% var sel = (jab.id == rs.idjabatan) ? 'selected' : ''; %>
                <option value="<%= jab.id %>" <%= sel %>><%= jab.nama %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group row">
          <label for="divisi" class="col-4 col-form-label">Divisi</label>
          <div class="col-8">
            <select id="divisi" name="divisi" class="custom-select">
              <option value="">-- Pilih Divisi --</option>
              <% divisiList.forEach(function(div) { %>
                <% var sel = (div.id == rs.iddivisi) ? 'selected' : ''; %>
                <option value="<%= div.id %>" <%= sel %>><%= div.nama %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="form-group row">
          <label for="email" class="col-4 col-form-label">Email</label>
          <div class="col-8">
            <input id="email" name="email" value="<%= rs.email || '' %>" type="text" class="form-control">
          </div>
        </div>
        <div class="form-group row">
          <label for="foto" class="col-4 col-form-label">Foto</label>
          <div class="col-8">
            <input id="foto" name="foto" type="text" value="<%= rs.foto || '' %>" class="form-control">
          </div>
        </div>
        <div class="form-group row">
          <label for="alamat" class="col-4 col-form-label">Alamat</label>
          <div class="col-8">
            <textarea id="alamat" name="alamat" cols="40" rows="3" class="form-control"><%= rs.alamat || '' %></textarea>
          </div>
        </div>
      </div>
    </div>
    <div class="form-group row mt-2">
      <div class="offset-4 col-8">
        <% if (!idedit) { %>
          <button name="proses" value="simpan" type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Simpan</button>
        <% } else { %>
          <button name="proses" value="ubah" type="submit" class="btn btn-warning"><i class="fas fa-pen mr-1"></i> Ubah</button>
          <button name="proses" value="hapus" type="submit" onClick="return confirm('Anda yakin ingin menghapus?')" class="btn btn-danger"><i class="fas fa-trash mr-1"></i> Hapus</button>
          <input type="hidden" name="idx" value="<%= idedit %>" />
        <% } %>
        <button name="proses" value="batal" type="submit" class="btn btn-info"><i class="fas fa-times mr-1"></i> Batal</button>
      </div>
    </div>
  </form>
<% } else { %>
  <%- include('../partials/denied') %>
<% } %>
