<% if (member) { %>
	<div class="tm-hero">
		<h2>Selamat Datang, <%= member.fullname %>!</h2>
		<p>
			Anda masuk sebagai <strong><%= member.role %></strong>. Gunakan menu kepegawaian di atas untuk mengelola data pegawai, presensi, kepangkatan, cuti, dan layanan kepegawaian lainnya.
		</p>
	</div>
	<div class="row mt-4">
		<div class="col-md-4 mb-3">
			<div class="tm-stat">
				<div class="stat-icon icon-indigo"><i class="fas fa-users"></i></div>
				<div class="stat-label">Data Pegawai</div>
				<div class="stat-value"><%= jumlahPegawai || 0 %></div>
				<a href="/?hal=pegawai" class="small">Kelola Pegawai <i class="fas fa-arrow-right"></i></a>
			</div>
		</div>
		<div class="col-md-4 mb-3">
			<div class="tm-stat">
				<div class="stat-icon icon-cyan"><i class="fas fa-building"></i></div>
				<div class="stat-label">Divisi</div>
				<div class="stat-value"><%= sidebarData.divisiList.length %></div>
				<a href="/?hal=divisi" class="small">Kelola Divisi <i class="fas fa-arrow-right"></i></a>
			</div>
		</div>
		<div class="col-md-4 mb-3">
			<div class="tm-stat">
				<div class="stat-icon icon-violet"><i class="fas fa-briefcase"></i></div>
				<div class="stat-label">Jabatan</div>
				<div class="stat-value"><%= sidebarData.jabatanList.length %></div>
				<a href="/?hal=jabatan" class="small">Kelola Jabatan <i class="fas fa-arrow-right"></i></a>
			</div>
		</div>
	</div>
<% } else { %>
	<div class="tm-hero">
		<h2>Selamat Datang di Sistem Kepegawaian</h2>
		<p>
			Selamat datang di Sistem Informasi Kepegawaian Tim Kerja Bidang Pendidikan Sekolah Dasar Kecamatan Lemahabang. Aplikasi ini digunakan untuk mengelola data kepegawaian meliputi profil pegawai, presensi, kepangkatan, gaji berkala, izin & cuti, diklat, serta layanan kepegawaian lainnya.
		</p>
		<p>
			Silakan login menggunakan akun Anda untuk mengakses seluruh menu dan layanan kepegawaian.
		</p>
		<p class="mb-0">
			<a class="btn btn-hero btn-lg" href="/?hal=form_login">
				<i class="fas fa-sign-in-alt mr-1"></i> Login
			</a>
			<a class="btn btn-hero-outline btn-lg ml-2" href="/?hal=aboutus">
				Tentang Kami <i class="fas fa-caret-right ml-1"></i>
			</a>
		</p>
	</div>
<% } %>
