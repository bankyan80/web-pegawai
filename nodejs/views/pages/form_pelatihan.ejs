<% if (member && member.role != 'staff') { %>
  <% var idedit = typeof idedit !== 'undefined' ? idedit : query.idedit || ''; %>
  <h3><i class="fas fa-graduation-cap text-primary mr-2"></i><%= idedit ? 'Ubah Pelatihan' : 'Tambah Pelatihan' %></h3>
  <div class="row mt-4">
    <div class="col-lg-8">
      <div class="border rounded p-4 bg-light">
        <%- include('../partials/form_pelatihan') %>
      </div>
    </div>
  </div>
<% } else { %>
  <%- include('../partials/denied') %>
<% } %>
