<% if (member && member.role != 'staff') { %>
  <% var idedit = query.idedit || ''; %>
  <% var rs = typeof rs !== 'undefined' ? rs : {}; %>
  <% var dis = idedit ? 'disabled' : ''; %>
  <h3><i class="fas fa-money-bill-wave text-primary mr-2"></i><%= idedit ? 'Ubah Gaji' : 'Tambah Gaji' %></h3>
  <form method="POST" action="/controller/gaji" class="mt-4">
    <input type="hidden" name="csrf_token" value="<%= csrf %>">
    <div class="form-group row">
      <label for="nama" class="col-4 col-form-label">Nama Pegawai</label>
      <div class="col-8">
        <select id="nama" name="nama" class="custom-select" <%= dis %>>
          <option value="">-- Nama Pegawai --</option>
          <% pegawai.forEach(function(peg) { %>
            <% if (peg.id == rs.pegawai_id) { %>
              <option value="<%= peg.id %>" selected><%= peg.nama %></option>
            <% } %>
          <% }) %>
          <% belumGaji.forEach(function(peg2) { %>
            <option value="<%= peg2.idp %>"><%= peg2.nama %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="form-group row">
      <label for="gapok" class="col-4 col-form-label">Gaji Pokok</label>
      <div class="col-8">
        <input id="gapok" value="<%= rs.gapok || '' %>" name="gapok" type="text" class="form-control">
      </div>
    </div>
    <div class="form-group row">
      <label for="tunjab" class="col-4 col-form-label">Tunjangan Jabatan</label>
      <div class="col-8">
        <input id="tunjab" name="tunjab" value="<%= rs.tunjab || '' %>" type="text" class="form-control">
      </div>
    </div>
    <div class="form-group row">
      <label for="bpjs" class="col-4 col-form-label">BPJS</label>
      <div class="col-8">
        <input id="bpjs" name="bpjs" value="<%= rs.bpjs || '' %>" type="text" class="form-control">
      </div>
    </div>
    <div class="form-group row">
      <label for="lain2" class="col-4 col-form-label">Lain-Lain</label>
      <div class="col-8">
        <input id="lain2" name="lain2" value="<%= rs.lain2 || '' %>" type="text" class="form-control">
      </div>
    </div>
    <div class="form-group row">
      <div class="offset-4 col-8">
        <% if (!idedit) { %>
          <button name="proses" value="simpan" type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Simpan</button>
        <% } else { %>
          <button name="proses" value="ubah" type="submit" class="btn btn-warning"><i class="fas fa-pen mr-1"></i> Ubah</button>
          <button name="proses" value="hapus" type="submit" onClick="return confirm('Anda yakin ingin menghapus?')" class="btn btn-danger"><i class="fas fa-trash mr-1"></i> Hapus</button>
          <input type="hidden" name="idx" value="<%= idedit %>" />
        <% } %>
        <button name="proses" value="batal" type="submit" class="btn btn-info"><i class="fas fa-times mr-1"></i> Batal</button>
      </div>
    </div>
  </form>
<% } else { %>
  <%- include('../partials/denied') %>
<% } %>
