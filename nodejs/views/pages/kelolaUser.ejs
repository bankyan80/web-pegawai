<% if (member && member.role == 'administrator') { %>
    <% function roleBadge(role) {
         var map = { administrator: 'badge-role-admin', staff: 'badge-role-staff' };
         var cls = map[role] || 'badge-role-staff';
         var label = role.charAt(0).toUpperCase() + role.slice(1);
         return '<span class="badge-tm ' + cls + '">' + label + '</span>';
       } %>
    <% var ar_judul = ['No', 'Fullname', 'Username', 'Role', 'Email', 'Foto', 'Action']; %>
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="mb-0"><i class="fas fa-user-cog text-primary mr-2"></i>Data Users</h3>
        <a href="/?hal=form_user" class="btn btn-primary"><i class="fas fa-plus mr-1"></i> Input User</a>
    </div>
    <% if (rs.length === 0) { %>
        <div class="tm-empty">
            <i class="fas fa-inbox"></i>
            Belum ada data user.
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table tm-table table-hover">
                <thead>
                    <tr>
                        <% ar_judul.forEach(function(jdl) { %>
                            <th scope="col"><%= jdl %></th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody>
                    <% var no = 1; %>
                    <% rs.forEach(function(member) { %>
                        <tr>
                            <th scope="row" class="row-head"><%= no %></th>
                            <td><strong><%= member.fullname %></strong></td>
                            <td><%= member.username %></td>
                            <td><%- roleBadge(member.role) %></td>
                            <td><%= member.email %></td>
                            <td>
                                <% if (!member.foto) { %>
                                    <img src="/images/no_photo.png" class="tm-thumb" alt="foto" />
                                <% } else { %>
                                    <img src="/images/<%= member.foto %>" class="tm-thumb" alt="foto" />
                                <% } %>
                            </td>
                            <td>
                                <a href="/?hal=form_user&idedit=<%= member.id %>" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Edit</a>
                            </td>
                        </tr>
                        <% no++; %>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
<% } else { %>
    <%- include('../partials/denied') %>
<% } %>
