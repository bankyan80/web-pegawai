<%- include('../partials/kep_header') %>

<div class="kep-toolbar pppk-toolbar">
	<div class="kep-toolbar-left">
		<div class="kep-search">
			<i class="fas fa-search"></i>
			<input type="text" class="form-control pppk-search" placeholder="Cari Nama / NIP / NIK..." />
		</div>
	</div>
	<div class="kep-toolbar-right pppk-filters">
		<select class="form-control form-control-sm pppk-filter" data-key="kepeg" title="Status Kepegawaian">
			<option value="">Status: Semua</option>
			<% (pppk.kepegList || []).forEach(function (k) { %>
				<option value="<%= k %>"><%= k %></option>
			<% }) %>
		</select>
		<select class="form-control form-control-sm pppk-filter" data-key="status" title="Status Periode">
			<option value="">Periode: Semua</option>
			<% (pppk.statusList || []).forEach(function (k) { %>
				<option value="<%= k %>"><%= k %></option>
			<% }) %>
		</select>
		<select class="form-control form-control-sm pppk-filter" data-key="sekolah" title="Sekolah / Unit Kerja">
			<option value="">Sekolah: Semua</option>
			<% (pppk.sekolahList || []).forEach(function (k) { %>
				<option value="<%= k %>"><%= k %></option>
			<% }) %>
		</select>
		<select class="form-control form-control-sm pppk-filter" data-key="tahun" title="Tahun TMT">
			<option value="">TMT: Semua</option>
			<% (pppk.tahunList || []).forEach(function (k) { %>
				<option value="<%= k %>"><%= k %></option>
			<% }) %>
		</select>
		<button type="button" class="btn btn-outline-secondary btn-kep-sm pppk-reset"><i class="fas fa-undo"></i> Reset</button>
		<button type="button" class="btn btn-outline-primary btn-kep-sm pppk-export"><i class="fas fa-file-excel"></i> Export Excel</button>
	</div>
</div>

<div class="kep-table-wrap">
	<table class="tm-table pppk-table" id="tblPppk">
		<thead>
			<tr>
				<th class="kep-no-col">No</th>
				<th>Nama Pegawai</th>
				<th>NIP/NI</th>
				<th>NIK</th>
				<th>NUPTK</th>
				<th>Status Kepeg.</th>
				<th>Jabatan</th>
				<th>Unit/Sekolah</th>
				<th>TMT</th>
				<th>Tgl Mulai</th>
				<th>Tgl Akhir</th>
				<th>Masa</th>
				<th>Periode Ke</th>
				<th>Sisa</th>
				<th>Status</th>
				<th class="kep-th-act">Aksi</th>
			</tr>
		</thead>
		<tbody id="pppkBody"></tbody>
	</table>
	<div class="kep-pager pppk-pager"></div>
</div>

<div class="modal fade" id="modalPppkDetail" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fas fa-eye"></i> <span>Detail Periode PPPK</span></h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<div class="modal-body">
				<table class="tm-table kep-detail-table">
					<tbody id="pppkDetailBody"></tbody>
				</table>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Tutup</button>
			</div>
		</div>
	</div>
</div>

<script>
	window.PPPK_CFG = {
		rows: <%- JSON.stringify(pppk.rows || []).replace(/</g, '\\u003c') %>
	};
</script>
<script src="/js/pppk.js"></script>
