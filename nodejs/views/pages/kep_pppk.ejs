<%- include('../partials/kep_header') %>

<% if (notif && notif.length) { %>
	<div class="pppk-notif">
		<% notif.forEach(function (n) { %>
			<div class="pppk-notif-item pppk-notif-<%= n.level %>">
				<i class="fas fa-exclamation-circle"></i>
				<span><%= n.text %></span>
			</div>
		<% }) %>
	</div>
<% } %>

<div class="kep-toolbar pppk-toolbar">
	<div class="kep-toolbar-left">
		<div class="kep-search">
			<i class="fas fa-search"></i>
			<input type="text" class="form-control pppk-search" placeholder="Cari NIP / nama / sekolah..." />
		</div>
		<select class="form-control pppk-filter" data-key="jenis">
			<option value="">Filter Jenis PPPK</option>
			<% (pppk.jenisList || []).forEach(function (o) { %>
				<option value="<%= o %>"><%= o %></option>
			<% }) %>
		</select>
		<select class="form-control pppk-filter" data-key="sekolah">
			<option value="">Filter Sekolah</option>
			<% (pppk.sekolahList || []).forEach(function (o) { %>
				<option value="<%= o %>"><%= o %></option>
			<% }) %>
		</select>
		<select class="form-control pppk-filter" data-key="status">
			<option value="">Filter Status</option>
			<option value="AKTIF">AKTIF</option>
			<option value="BELUM AKTIF">BELUM AKTIF</option>
			<option value="SEGERA BERAKHIR">SEGERA BERAKHIR</option>
			<option value="BERAKHIR">BERAKHIR</option>
		</select>
		<select class="form-control pppk-filter" data-key="tahun">
			<option value="">Filter Tahun</option>
			<% (pppk.tahunList || []).forEach(function (o) { %>
				<option value="<%= o %>"><%= o %></option>
			<% }) %>
		</select>
	</div>
	<div class="kep-toolbar-right">
		<button type="button" class="btn btn-outline-secondary btn-kep-sm pppk-reset"><i class="fas fa-undo"></i> Reset</button>
		<button type="button" class="btn btn-outline-primary btn-kep-sm pppk-export"><i class="fas fa-file-excel"></i> Export Excel</button>
	</div>
</div>

<div class="kep-table-wrap">
	<table class="tm-table pppk-table" id="tblPppk">
		<thead>
			<tr>
				<th class="kep-no-col">No</th>
				<th>Nama Pegawai</th>
				<th>NIP/NI</th>
				<th>NIK</th>
				<th>Sekolah</th>
				<th>Jabatan</th>
				<th>Jenis PPPK</th>
				<th>Periode Ke</th>
				<th>No. Perjanjian</th>
				<th>Tgl. Mulai</th>
				<th>Tgl. Berakhir</th>
				<th>Sisa Periode</th>
				<th>Status</th>
				<th class="kep-th-act">Aksi</th>
			</tr>
		</thead>
		<tbody id="pppkBody"></tbody>
	</table>
	<div class="kep-pager pppk-pager"></div>
</div>

<% var pppkUnit = member && member.unit ? member.unit : ''; %>

<div class="modal fade" id="modalPppk" tabindex="-1" role="dialog" aria-hidden="true" data-title-ori="Tambah Periode PPPK">
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fas fa-pen-square"></i> <span class="pppk-modal-title">Tambah Periode PPPK</span></h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<form class="pppk-form" novalidate>
				<input type="hidden" name="pegawai_id" value="" />
				<div class="modal-body">
					<div class="row">
						<div class="col-md-6 form-group">
							<label for="pppk_pegawai">Pegawai <span class="text-danger">*</span></label>
							<select class="form-control pppk-pegawai" id="pppk_pegawai" required>
								<option value="">-- Pilih Pegawai --</option>
							</select>
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_nip">NIP/NI</label>
							<input type="text" class="form-control" name="nip" id="pppk_nip" readonly />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_nama">Nama</label>
							<input type="text" class="form-control" name="nama" id="pppk_nama" readonly />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_nik">NIK</label>
							<input type="text" class="form-control" name="nik" id="pppk_nik" readonly />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_sekolah">Sekolah</label>
							<input type="text" class="form-control" name="sekolah" id="pppk_sekolah" <%= pppk.isStaff ? 'readonly' : '' %> />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_jabatan">Jabatan</label>
							<input type="text" class="form-control" name="jabatan" id="pppk_jabatan" readonly />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_npsn">NPSN Sekolah</label>
							<input type="text" class="form-control" name="npsn" id="pppk_npsn" />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_jenis">Jenis PPPK <span class="text-danger">*</span></label>
							<select class="form-control" name="jenis" id="pppk_jenis" required>
								<option value="">-- Pilih Jenis PPPK --</option>
								<option value="PPPK Penuh Waktu">PPPK Penuh Waktu</option>
								<option value="PPPK Paruh Waktu">PPPK Paruh Waktu</option>
							</select>
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_nomor">Nomor Perjanjian <span class="text-danger">*</span></label>
							<input type="text" class="form-control" name="nomor_perjanjian" id="pppk_nomor" required />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_tgl_perjanjian">Tanggal Perjanjian <span class="text-danger">*</span></label>
							<input type="date" class="form-control" name="tanggal_perjanjian" id="pppk_tgl_perjanjian" required />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_mulai">Tanggal Mulai <span class="text-danger">*</span></label>
							<input type="date" class="form-control" name="tanggal_mulai" id="pppk_mulai" required />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_berakhir">Tanggal Berakhir <span class="text-danger">*</span></label>
							<input type="date" class="form-control" name="tanggal_berakhir" id="pppk_berakhir" required />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_dokumen">Dokumen Perjanjian (PDF)</label>
							<input type="file" class="form-control-file" name="dokumen" id="pppk_dokumen" accept=".pdf,application/pdf" />
							<small class="form-text text-muted">Maks. 2 MB, format PDF</small>
						</div>
						<div class="col-md-6 form-group">
							<label for="pppk_keterangan">Keterangan</label>
							<textarea class="form-control" name="keterangan" id="pppk_keterangan" rows="2"></textarea>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Batal</button>
					<button type="submit" class="btn btn-primary btn-kep-sm"><i class="fas fa-save"></i> Simpan</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade" id="modalPppkDetail" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fas fa-eye"></i> <span>Detail Periode PPPK</span></h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<div class="modal-body">
				<table class="tm-table kep-detail-table">
					<tbody id="pppkDetailBody"></tbody>
				</table>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Tutup</button>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="modalPppkPerpanjang" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fas fa-hourglass-half"></i> <span>Perpanjang Periode PPPK</span></h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<form class="pppk-form-perpanjang" novalidate>
				<div class="modal-body">
					<div class="pppk-extend-info mb-3" id="pppkExtendInfo"></div>
					<div class="row">
						<div class="col-md-6 form-group">
							<label for="pppkExtNomor">Nomor Perjanjian Baru</label>
							<input type="text" class="form-control" name="nomor_perjanjian" id="pppkExtNomor" />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppkExtTglPerjanjian">Tanggal Perjanjian Baru</label>
							<input type="date" class="form-control" name="tanggal_perjanjian" id="pppkExtTglPerjanjian" />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppkExtMulai">Tanggal Mulai Periode Baru <span class="text-danger">*</span></label>
							<input type="date" class="form-control" name="tanggal_mulai" id="pppkExtMulai" required />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppkExtBerakhir">Tanggal Berakhir Periode Baru <span class="text-danger">*</span></label>
							<input type="date" class="form-control" name="tanggal_berakhir" id="pppkExtBerakhir" required />
						</div>
						<div class="col-md-6 form-group">
							<label for="pppkExtDokumen">Dokumen Perjanjian Baru (PDF)</label>
							<input type="file" class="form-control-file" name="dokumen" id="pppkExtDokumen" accept=".pdf,application/pdf" />
							<small class="form-text text-muted">Maks. 2 MB, format PDF</small>
						</div>
						<div class="col-md-6 form-group">
							<label for="pppkExtKeterangan">Keterangan</label>
							<textarea class="form-control" name="keterangan" id="pppkExtKeterangan" rows="2"></textarea>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Batal</button>
					<button type="submit" class="btn btn-primary btn-kep-sm"><i class="fas fa-save"></i> Perpanjang</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade" id="modalPppkRiwayat" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog modal-xl modal-dialog-centered" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fas fa-history"></i> <span>Riwayat Periode PPPK</span></h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<div class="modal-body">
				<div class="pppk-riwayat-info mb-3" id="pppkRiwayatInfo"></div>
				<div class="table-responsive">
					<table class="tm-table pppk-riwayat-table">
						<thead>
							<tr>
								<th>Periode Ke</th>
								<th>No. Perjanjian</th>
								<th>Tgl. Mulai</th>
								<th>Tgl. Berakhir</th>
								<th>Sisa</th>
								<th>Status</th>
								<th>Dokumen</th>
								<th>Aksi</th>
								<th>Oleh</th>
							</tr>
						</thead>
						<tbody id="pppkRiwayatBody"></tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Tutup</button>
			</div>
		</div>
	</div>
</div>

<script>
	window.PPPK_CFG = {
		rows: <%- JSON.stringify(pppk.rows || []).replace(/</g, '\\u003c') %>,
		options: <%- JSON.stringify(pegawaiOptions || []).replace(/</g, '\\u003c') %>,
		canDelete: <%- pppk.canDelete ? 'true' : 'false' %>,
		canExtend: <%- pppk.canExtend ? 'true' : 'false' %>,
		isStaff: <%- pppk.isStaff ? 'true' : 'false' %>,
		unit: <%- JSON.stringify(pppkUnit) %>
	};
</script>
<script src="/js/pppk.js"></script>
