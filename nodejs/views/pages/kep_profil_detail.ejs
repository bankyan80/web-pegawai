<%- include('../partials/kep_header', { breadcrumb, title, desc, primaryBtn }) %>

<div class="kep-detail-pegawai">
	<div class="kep-dp-card">
		<div class="kep-dp-foto">
			<img src="<%= p.foto || '/images/no_photo.png' %>" alt="Foto Pegawai" />
		</div>
		<div class="kep-dp-ident">
			<h5 class="kep-dp-nama"><%= p.nama %></h5>
			<div class="kep-dp-nip"><%= p.nip %></div>
			<span class="kep-badge kb-<%= p.jenis === 'PNS' ? 'blue' : 'green' %>"><%= p.jenis %></span>
		</div>
		<div class="kep-dp-actions">
			<button type="button" class="btn btn-outline-primary btn-kep-sm kep-print"><i class="fas fa-print"></i> Cetak Profil</button>
			<% if (canSelfEdit) { %>
				<label class="btn btn-outline-primary btn-kep-sm" for="kepFotoInput" role="button"><i class="fas fa-camera"></i> Ganti Foto</label>
				<input type="file" id="kepFotoInput" accept="image/*" class="d-none" />
				<button type="button" class="btn btn-outline-primary btn-kep-sm" data-toggle="modal" data-target="#kepEditModal"><i class="fas fa-edit"></i> Edit Profil</button>
			<% } %>
			<% if (canManage) { %>
				<a class="btn btn-outline-primary btn-kep-sm" href="/profil-pegawai?edit=<%= p.id %>"><i class="fas fa-edit"></i> Edit</a>
				<button type="button" class="btn btn-outline-danger btn-kep-sm kep-hapus-single" data-id="<%= p.id %>"><i class="fas fa-trash"></i> Hapus</button>
			<% } %>
		</div>
	</div>

	<ul class="nav kep-tabs kep-tabs-detail" role="tablist">
		<li class="nav-item"><a class="nav-link active" id="dp-profil-tab" data-toggle="tab" href="#dp-profil" role="tab"><i class="fas fa-user"></i> Profil</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-kepeg-tab" data-toggle="tab" href="#dp-kepeg" role="tab"><i class="fas fa-briefcase"></i> Kepegawaian</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-pdd-tab" data-toggle="tab" href="#dp-pdd" role="tab"><i class="fas fa-graduation-cap"></i> Pendidikan</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-pangkat-tab" data-toggle="tab" href="#dp-pangkat" role="tab"><i class="fas fa-award"></i> Riwayat Pangkat</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-jab-tab" data-toggle="tab" href="#dp-jab" role="tab"><i class="fas fa-id-badge"></i> Riwayat Jabatan</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-diklat-tab" data-toggle="tab" href="#dp-diklat" role="tab"><i class="fas fa-chalkboard-teacher"></i> Diklat</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-doc-tab" data-toggle="tab" href="#dp-doc" role="tab"><i class="fas fa-folder-open"></i> Dokumen</a></li>
	</ul>

	<div class="tab-content kep-tab-content">
		<div class="tab-pane fade show active" id="dp-profil" role="tabpanel">
			<table class="tm-table kep-detail-table">
				<tbody>
					<% [['Nama Lengkap', p.nama], ['NIP', p.nip], ['NIK', p.nik], ['Tempat / Tgl Lahir', p.ttl], ['Jenis Kelamin', p.jk], ['Alamat', p.alamat], ['No. HP', p.hp], ['Email', p.email], ['Pendidikan Terakhir', (p.pendidikan || '') + (p.jurusan ? ' — ' + p.jurusan : '')], ['Sekolah', p.sekolah]].forEach(function (row) { %>
						<tr><td><%= row[0] %></td><td><%= row[1] %></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>

		<div class="tab-pane fade" id="dp-kepeg" role="tabpanel">
			<% if (canSelfEdit) { %>
				<div class="d-flex justify-content-end mb-2">
					<button type="button" class="btn btn-outline-primary btn-kep-sm kep-add" data-form="kepKepegModal" data-modul="profil"><i class="fas fa-edit"></i> Edit Kepegawaian</button>
				</div>
			<% } %>
			<table class="tm-table kep-detail-table">
				<tbody>
					<% [['Pangkat/Golongan', (p.pangkat || '') + (p.golongan ? ' — ' + p.golongan : '')], ['Jabatan', p.jabatan], ['Status Kepegawaian', p.status], ['TMT', p.tmt], ['Unit Kerja', p.unit]].forEach(function (row) { %>
						<tr><td><%= row[0] %></td><td><%= row[1] %></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>

		<div class="tab-pane fade" id="dp-pdd" role="tabpanel">
			<% if (canSelfEdit) { %>
				<div class="d-flex justify-content-end mb-2">
					<button type="button" class="btn btn-primary btn-kep-sm kep-add" data-form="kepPddModal" data-modul="pendidikan"><i class="fas fa-plus"></i> Tambah Pendidikan</button>
				</div>
			<% } %>
			<table class="tm-table kep-table">
				<thead><tr><th class="kep-no-col">No</th><th>Jenjang</th><th>Jurusan</th><th>Institusi</th><th>Tahun Lulus</th><% if (canSelfEdit) { %><th class="kep-th-act">Aksi</th><% } %></tr></thead>
				<tbody>
					<% if ((p.pendidikan || []).length) { (p.pendidikan).forEach(function (r, i) { %>
						<tr>
							<td class="kep-no"><%= i + 1 %></td>
							<td><%= r.jenjang %></td>
							<td><%= r.jurusan %></td>
							<td><%= r.nama_sekolah %></td>
							<td><%= r.tahun_lulus %></td>
							<% if (canSelfEdit) { %>
							<td class="kep-td-act">
								<button type="button" class="btn btn-sm btn-outline-primary kep-edit" data-form="kepPddModal" data-modul="pendidikan" data-rec='<%= JSON.stringify(r) %>' title="Edit"><i class="fas fa-edit"></i></button>
								<button type="button" class="btn btn-sm btn-outline-danger kep-del" data-modul="pendidikan" data-id="<%= r.id %>" title="Hapus"><i class="fas fa-trash"></i></button>
							</td>
							<% } %>
						</tr>
					<% }); } else { %>
						<tr><td colspan="<%= canSelfEdit ? 6 : 5 %>" class="text-center text-muted">Belum ada data pendidikan.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-pangkat" role="tabpanel">
			<% if (canSelfEdit) { %>
				<div class="d-flex justify-content-end mb-2">
					<button type="button" class="btn btn-primary btn-kep-sm kep-add" data-form="kepPangkatModal" data-modul="riwayat_pangkat"><i class="fas fa-plus"></i> Tambah Riwayat Pangkat</button>
				</div>
			<% } %>
			<table class="tm-table kep-table">
				<thead><tr><th class="kep-no-col">No</th><th>Pangkat</th><th>Golongan</th><th>TMT</th><th>No. SK</th><% if (canSelfEdit) { %><th class="kep-th-act">Aksi</th><% } %></tr></thead>
				<tbody>
					<% if ((p.riwayatPangkat || []).length) { (p.riwayatPangkat).forEach(function (r, i) { %>
						<tr>
							<td class="kep-no"><%= i + 1 %></td>
							<td><%= r.pangkat %></td>
							<td><%= r.golongan %></td>
							<td><%= r.tmt %></td>
							<td><%= r.nomor_sk %></td>
							<% if (canSelfEdit) { %>
							<td class="kep-td-act">
								<button type="button" class="btn btn-sm btn-outline-primary kep-edit" data-form="kepPangkatModal" data-modul="riwayat_pangkat" data-rec='<%= JSON.stringify(r) %>' title="Edit"><i class="fas fa-edit"></i></button>
								<button type="button" class="btn btn-sm btn-outline-danger kep-del" data-modul="riwayat_pangkat" data-id="<%= r.id %>" title="Hapus"><i class="fas fa-trash"></i></button>
							</td>
							<% } %>
						</tr>
					<% }); } else { %>
						<tr><td colspan="<%= canSelfEdit ? 6 : 5 %>" class="text-center text-muted">Belum ada riwayat pangkat.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>

		<div class="tab-pane fade" id="dp-jab" role="tabpanel">
			<% if (canSelfEdit) { %>
				<div class="d-flex justify-content-end mb-2">
					<button type="button" class="btn btn-primary btn-kep-sm kep-add" data-form="kepJabModal" data-modul="jabatan"><i class="fas fa-plus"></i> Tambah Riwayat Jabatan</button>
				</div>
			<% } %>
			<table class="tm-table kep-table">
				<thead><tr><th class="kep-no-col">No</th><th>Jabatan</th><th>Jenis</th><th>TMT</th><th>No. SK</th><% if (canSelfEdit) { %><th class="kep-th-act">Aksi</th><% } %></tr></thead>
				<tbody>
					<% if ((p.riwayatJabatan || []).length) { (p.riwayatJabatan).forEach(function (r, i) { %>
						<tr>
							<td class="kep-no"><%= i + 1 %></td>
							<td><%= r.jabatan %></td>
							<td><%= r.jenis %></td>
							<td><%= r.tmt %></td>
							<td><%= r.nomor_sk %></td>
							<% if (canSelfEdit) { %>
							<td class="kep-td-act">
								<button type="button" class="btn btn-sm btn-outline-primary kep-edit" data-form="kepJabModal" data-modul="jabatan" data-rec='<%= JSON.stringify(r) %>' title="Edit"><i class="fas fa-edit"></i></button>
								<button type="button" class="btn btn-sm btn-outline-danger kep-del" data-modul="jabatan" data-id="<%= r.id %>" title="Hapus"><i class="fas fa-trash"></i></button>
							</td>
							<% } %>
						</tr>
					<% }); } else { %>
						<tr><td colspan="<%= canSelfEdit ? 6 : 5 %>" class="text-center text-muted">Belum ada riwayat jabatan.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-diklat" role="tabpanel">
			<% if (canSelfEdit) { %>
				<div class="d-flex justify-content-end mb-2">
					<button type="button" class="btn btn-primary btn-kep-sm kep-add" data-form="kepDiklatModal" data-modul="diklat"><i class="fas fa-plus"></i> Tambah Diklat</button>
				</div>
			<% } %>
			<table class="tm-table kep-table">
				<thead><tr><th class="kep-no-col">No</th><th>Nama Diklat</th><th>Jenis</th><th>Penyelenggara</th><th>Tahun</th><% if (canSelfEdit) { %><th class="kep-th-act">Aksi</th><% } %></tr></thead>
				<tbody>
					<% if ((p.diklat || []).length) { (p.diklat).forEach(function (r, i) { %>
						<tr>
							<td class="kep-no"><%= i + 1 %></td>
							<td><%= r.nama_diklat %></td>
							<td><span class="kep-badge kb-<%= r.jenis === 'struktural' ? 'blue' : 'green' %>"><%= r.jenis %></span></td>
							<td><%= r.penyelenggara %></td>
							<td><%= r.tahun %></td>
							<% if (canSelfEdit) { %>
							<td class="kep-td-act">
								<button type="button" class="btn btn-sm btn-outline-primary kep-edit" data-form="kepDiklatModal" data-modul="diklat" data-rec='<%= JSON.stringify(r) %>' title="Edit"><i class="fas fa-edit"></i></button>
								<button type="button" class="btn btn-sm btn-outline-danger kep-del" data-modul="diklat" data-id="<%= r.id %>" title="Hapus"><i class="fas fa-trash"></i></button>
							</td>
							<% } %>
						</tr>
					<% }); } else { %>
						<tr><td colspan="<%= canSelfEdit ? 6 : 5 %>" class="text-center text-muted">Belum ada data diklat.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>

		<div class="tab-pane fade" id="dp-doc" role="tabpanel">
			<% if (canSelfEdit) { %>
				<div class="d-flex justify-content-end mb-2">
					<button type="button" class="btn btn-primary btn-kep-sm kep-add" data-form="kepDocModal" data-modul="arsip"><i class="fas fa-upload"></i> Upload Dokumen</button>
				</div>
			<% } %>
			<table class="tm-table kep-table">
				<thead><tr><th class="kep-no-col">No</th><th>Nama Dokumen</th><th>Kategori</th><% if (canSelfEdit) { %><th class="kep-th-act">Aksi</th><% } %></tr></thead>
				<tbody>
					<% if ((p.dokumen || []).length) { (p.dokumen).forEach(function (r, i) { %>
						<tr>
							<td class="kep-no"><%= i + 1 %></td>
							<td><% if (r.file) { %><a href="<%= r.file %>" target="_blank" rel="noopener"><i class="fas fa-file-alt text-primary"></i> <%= r.nama_dokumen %></a><% } else { %><%= r.nama_dokumen %><% } %></td>
							<td><%= r.kategori %></td>
							<% if (canSelfEdit) { %>
							<td class="kep-td-act">
								<button type="button" class="btn btn-sm btn-outline-primary kep-edit" data-form="kepDocModal" data-modul="arsip" data-rec='<%= JSON.stringify(r) %>' title="Edit"><i class="fas fa-edit"></i></button>
								<button type="button" class="btn btn-sm btn-outline-danger kep-del" data-modul="arsip" data-id="<%= r.id %>" title="Hapus"><i class="fas fa-trash"></i></button>
							</td>
							<% } %>
						</tr>
					<% }); } else { %>
						<tr><td colspan="<%= canSelfEdit ? 4 : 3 %>" class="text-center text-muted">Belum ada dokumen.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</div>
</div>
<% if (canSelfEdit) { %>
<div class="modal fade" id="kepEditModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title kep-modal-title"><i class="fas fa-user-edit"></i> Edit Profil</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<form id="kepProfilForm" class="kep-form">
				<div class="modal-body">
					<div class="kep-form-grid">
						<div class="kep-field">
							<label>Jenis Kelamin</label>
							<select class="form-control" name="jk">
								<option value="">-- Pilih --</option>
								<option value="Laki-laki" <%= p.jk === 'Laki-laki' ? 'selected' : '' %>>Laki-laki</option>
								<option value="Perempuan" <%= p.jk === 'Perempuan' ? 'selected' : '' %>>Perempuan</option>
							</select>
						</div>
						<div class="kep-field">
							<label>Tempat / Tgl Lahir</label>
							<input type="text" class="form-control" name="ttl" value="<%= p.ttl || '' %>" />
						</div>
						<div class="kep-field">
							<label>Alamat</label>
							<textarea class="form-control" name="alamat" rows="2"><%= p.alamat || '' %></textarea>
						</div>
						<div class="kep-field">
							<label>No. HP</label>
							<input type="text" class="form-control" name="hp" value="<%= p.hp || '' %>" />
						</div>
						<div class="kep-field">
							<label>Email</label>
							<input type="email" class="form-control" name="email" value="<%= p.email || '' %>" />
						</div>
						<div class="kep-field">
							<label>Jurusan</label>
							<input type="text" class="form-control" name="jurusan" value="<%= p.jurusan || '' %>" />
						</div>
						<div class="kep-field">
							<label>Sekolah</label>
							<input type="text" class="form-control" name="sekolah" value="<%= p.sekolah || '' %>" />
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Batal</button>
					<button type="submit" class="btn btn-primary btn-kep-sm"><i class="fas fa-save"></i> Simpan</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade" id="kepKepegModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title kep-modal-title"><i class="fas fa-briefcase"></i> Edit Kepegawaian</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<form id="kepKepegForm" class="kep-form">
				<div class="modal-body">
					<div class="kep-form-grid">
						<div class="kep-field">
							<label>Pangkat</label>
							<input type="text" class="form-control" name="pangkat" value="<%= p.pangkat || '' %>" />
						</div>
						<div class="kep-field">
							<label>Golongan</label>
							<input type="text" class="form-control" name="golongan" value="<%= p.golongan || '' %>" />
						</div>
						<div class="kep-field">
							<label>Jabatan</label>
							<input type="text" class="form-control" name="jabatan" value="<%= p.jabatan || '' %>" />
						</div>
						<div class="kep-field">
							<label>Unit Kerja</label>
							<input type="text" class="form-control" name="unit" value="<%= p.unit || '' %>" />
						</div>
						<div class="kep-field">
							<label>TMT</label>
							<input type="text" class="form-control" name="tmt" value="<%= p.tmt || '' %>" />
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Batal</button>
					<button type="submit" class="btn btn-primary btn-kep-sm"><i class="fas fa-save"></i> Simpan</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade" id="kepPddModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title kep-modal-title"><i class="fas fa-graduation-cap"></i> Pendidikan</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<form id="kepPddForm" class="kep-form" data-modul="pendidikan">
				<div class="modal-body">
					<div class="kep-form-grid">
						<div class="kep-field">
							<label>Jenjang</label>
							<select class="form-control" name="jenjang">
								<option value="">-- Pilih --</option>
								<% ['SD', 'SMP', 'SMA', 'SMK', 'D1', 'D2', 'D3', 'D4', 'S1', 'S2', 'S3'].forEach(function (o) { %><option value="<%= o %>"><%= o %></option><% }) %>
							</select>
						</div>
						<div class="kep-field">
							<label>Jurusan</label>
							<input type="text" class="form-control" name="jurusan" />
						</div>
						<div class="kep-field">
							<label>Institusi / Sekolah</label>
							<input type="text" class="form-control" name="nama_sekolah" />
						</div>
						<div class="kep-field">
							<label>Tahun Lulus</label>
							<input type="text" class="form-control" name="tahun_lulus" />
						</div>
						<div class="kep-field">
							<label>IPK</label>
							<input type="text" class="form-control" name="ipk" />
						</div>
						<div class="kep-field">
							<label>Keterangan</label>
							<textarea class="form-control" name="keterangan" rows="2"></textarea>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Batal</button>
					<button type="submit" class="btn btn-primary btn-kep-sm"><i class="fas fa-save"></i> Simpan</button>
				</div>
			</form>
		</div>
	</div>
</div>
<div class="modal fade" id="kepPangkatModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title kep-modal-title"><i class="fas fa-award"></i> Riwayat Pangkat</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<form id="kepPangkatForm" class="kep-form" data-modul="riwayat_pangkat">
				<div class="modal-body">
					<div class="kep-form-grid">
						<div class="kep-field">
							<label>Pangkat</label>
							<input type="text" class="form-control" name="pangkat" />
						</div>
						<div class="kep-field">
							<label>Golongan</label>
							<input type="text" class="form-control" name="golongan" />
						</div>
						<div class="kep-field">
							<label>TMT</label>
							<input type="text" class="form-control" name="tmt" />
						</div>
						<div class="kep-field">
							<label>No. SK</label>
							<input type="text" class="form-control" name="nomor_sk" />
						</div>
						<div class="kep-field">
							<label>Keterangan</label>
							<textarea class="form-control" name="keterangan" rows="2"></textarea>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Batal</button>
					<button type="submit" class="btn btn-primary btn-kep-sm"><i class="fas fa-save"></i> Simpan</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="modal fade" id="kepJabModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content kep-modal">
