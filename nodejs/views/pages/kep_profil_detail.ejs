<div class="modal fade" id="kepDocModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog" role="document">
		<div class="modal-content kep-modal">
			<div class="modal-header">
				<h5 class="modal-title kep-modal-title"><i class="fas fa-folder-open"></i> Dokumen</h5>
				<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
			</div>
			<form id="kepDocForm" class="kep-form" data-modul="arsip">
				<div class="modal-body">
					<div class="kep-form-grid">
						<div class="kep-field">
							<label>Kategori</label>
							<select class="form-control" name="kategori">
								<option value="">-- Pilih --</option>
								<% ['Ijazah', 'SK', 'Sertifikat', 'Surat', 'Kartu', 'Lainnya'].forEach(function (o) { %><option value="<%= o %>"><%= o %></option><% }) %>
							</select>
						</div>
						<div class="kep-field">
							<label>Nama Dokumen</label>
							<input type="text" class="form-control" name="nama_dokumen" />
						</div>
						<div class="kep-field">
							<label>File</label>
							<input type="file" class="form-control" name="file" />
						</div>
						<div class="kep-field">
							<label>Keterangan</label>
							<textarea class="form-control" name="keterangan" rows="2"></textarea>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary btn-kep-sm" data-dismiss="modal">Batal</button>
					<button type="submit" class="btn btn-primary btn-kep-sm"><i class="fas fa-save"></i> Simpan</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
(function () {
	var meta = document.querySelector('meta[name="csrf-token"]');
	function csrfHeaders() {
		return { 'Content-Type': 'application/json', 'X-CSRF-Token': meta ? meta.content : '' };
	}
	function toast(msg) {
		if (typeof kepToast === 'function') kepToast(msg);
		else alert(msg);
	}
	function collectForm(form) {
		var data = {};
		Array.prototype.slice.call(form.querySelectorAll('[name]')).forEach(function (el) {
			if (el.type === 'file') return;
			data[el.name] = el.value;
		});
		return data;
	}
	function openForm(formId, rec) {
		var form = document.getElementById(formId);
		if (!form) return;
		form.removeAttribute('data-editing-id');
		form.setAttribute('data-file', rec ? (rec.file || '') : '');
		Array.prototype.slice.call(form.querySelectorAll('[name]')).forEach(function (el) {
			if (el.type === 'file') { el.value = ''; return; }
			var val = rec ? (rec[el.name] == null ? '' : rec[el.name]) : '';
			if (el.tagName === 'SELECT' && String(val) !== '' && el.value !== String(val)) {
				var opt = document.createElement('option');
				opt.value = String(val);
				opt.textContent = String(val) + ' (nilai lama)';
				el.appendChild(opt);
			}
			el.value = val;
		});
		$('#' + formId).modal('show');
	}
	function submitSelf(form, modul, extra) {
		var data = collectForm(form);
		if (extra) Object.keys(extra).forEach(function (k) { data[k] = extra[k]; });
		if (!data.file && form.getAttribute('data-file')) data.file = form.getAttribute('data-file');
		var editing = form.getAttribute('data-editing-id');
		var url = '/api/self/' + modul + (editing ? '/' + editing : '');
		fetch(url, {
			method: editing ? 'PUT' : 'POST',
			headers: csrfHeaders(),
			body: JSON.stringify(data)
		}).then(function (r) { return r.json(); }).then(function (j) {
			if (j.ok) {
				$('#' + form.id).modal('hide');
				toast(editing ? 'Data berhasil diubah.' : 'Data berhasil ditambah.');
				setTimeout(function () { location.reload(); }, 600);
			} else {
				toast('Gagal simpan: ' + (j.error || 'unknown'));
			}
		}).catch(function (err) { toast('Gagal simpan: ' + err.message); });
	}
	function uploadSelf(file, cb) {
		var reader = new FileReader();
		reader.onload = function () {
			var b64 = String(reader.result).split(',')[1] || '';
			fetch('/api/self/upload', {
				method: 'POST',
				headers: csrfHeaders(),
				body: JSON.stringify({ filename: file.name || 'dokumen.pdf', contentType: file.type || 'application/octet-stream', base64: b64 })
			}).then(function (r) { return r.json(); }).then(function (j) {
				if (j.ok && j.url) cb(null, j.url);
				else cb(j.error || 'Upload gagal', null);
			}).catch(function (err) { cb(err.message, null); });
		};
		reader.readAsDataURL(file);
	}
	function bindForm(formId, modul) {
		var form = document.getElementById(formId);
		if (!form) return;
		form.addEventListener('submit', function (e) {
			e.preventDefault();
			var fileEl = form.querySelector('[type="file"]');
			var hasFile = fileEl && fileEl.files && fileEl.files.length;
			if (hasFile) {
				uploadSelf(fileEl.files[0], function (err, url) {
					if (err) { toast('Upload gagal: ' + err); return; }
					submitSelf(form, modul, { file: url });
				});
			} else {
				submitSelf(form, modul, null);
			}
		});
	}
	bindForm('kepPddForm', 'pendidikan');
	bindForm('kepPangkatForm', 'riwayat_pangkat');
	bindForm('kepJabForm', 'jabatan');
	bindForm('kepDiklatForm', 'diklat');
	bindForm('kepDocForm', 'arsip');

	function bindPut(formId) {
		var form = document.getElementById(formId);
		if (!form) return;
		form.addEventListener('submit', function (e) {
			e.preventDefault();
			var data = collectForm(form);
			fetch('/api/self/profil', {
				method: 'PUT',
				headers: csrfHeaders(),
				body: JSON.stringify(data)
			}).then(function (r) { return r.json(); }).then(function (j) {
				if (j.ok) {
					$('#' + form.id).modal('hide');
					toast('Profil berhasil diubah.');
					setTimeout(function () { location.reload(); }, 600);
				} else {
					toast('Simpan gagal: ' + (j.error || 'unknown'));
				}
			}).catch(function (err) { toast('Simpan gagal: ' + err.message); });
		});
	}
	bindPut('kepProfilForm');
	bindPut('kepKepegForm');

	document.addEventListener('click', function (e) {
		var add = e.target.closest('.kep-add');
		if (add) {
			openForm(add.getAttribute('data-form'), null);
			return;
		}
		var edit = e.target.closest('.kep-edit');
		if (edit) {
			var rec = {};
			try { rec = JSON.parse(edit.getAttribute('data-rec') || '{}'); } catch (err) {}
			openForm(edit.getAttribute('data-form'), rec);
			var f = document.getElementById(edit.getAttribute('data-form'));
			if (f && rec.id) f.setAttribute('data-editing-id', rec.id);
			return;
		}
		var del = e.target.closest('.kep-del');
		if (del) {
			var modul = del.getAttribute('data-modul');
			var id = del.getAttribute('data-id');
			if (!confirm('Yakin ingin menghapus data ini?')) return;
			fetch('/api/self/' + modul + '/' + id, { method: 'DELETE', headers: csrfHeaders() })
				.then(function (r) { return r.json(); })
				.then(function (j) {
					if (j.ok) {
						toast('Data berhasil dihapus.');
						setTimeout(function () { location.reload(); }, 600);
					} else {
						toast('Gagal hapus: ' + (j.error || 'unknown'));
					}
				})
				.catch(function () { toast('Terjadi kesalahan saat menghapus.'); });
		}
	});

	var fotoInput = document.getElementById('kepFotoInput');
	if (fotoInput) {
		fotoInput.addEventListener('change', function () {
			var f = fotoInput.files[0];
			if (!f) return;
			var reader = new FileReader();
			reader.onload = function () {
				var b64 = String(reader.result).split(',')[1] || '';
				fetch('/api/self/foto', {
					method: 'POST',
					headers: csrfHeaders(),
					body: JSON.stringify({ filename: (f.name || 'foto.png').replace(/[^a-zA-Z0-9._-]/g, '_'), contentType: f.type || 'image/png', base64: b64 })
				}).then(function (r) { return r.json(); }).then(function (j) {
					if (j.ok) { location.reload(); }
					else toast('Ganti foto gagal: ' + (j.error || 'unknown'));
				}).catch(function (err) { toast('Ganti foto gagal: ' + err.message); });
			};
			reader.readAsDataURL(f);
		});
	}
})();
</script>
<% } %>
