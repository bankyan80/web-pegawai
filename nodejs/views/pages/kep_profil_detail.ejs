<%- include('../partials/kep_header', { breadcrumb, title, desc, primaryBtn }) %>

<div class="kep-detail-pegawai">
	<div class="kep-dp-card">
		<div class="kep-dp-foto">
			<img src="/images/no_photo.png" alt="Foto Pegawai" />
		</div>
		<div class="kep-dp-ident">
			<h5 class="kep-dp-nama"><%= p.nama %></h5>
			<div class="kep-dp-nip"><%= p.nip %></div>
			<span class="kep-badge kb-<%= p.jenis === 'PNS' ? 'blue' : 'green' %>"><%= p.jenis %></span>
		</div>
		<div class="kep-dp-actions">
			<button type="button" class="btn btn-outline-primary btn-kep-sm kep-print"><i class="fas fa-print"></i> Cetak Profil</button>
			<button type="button" class="btn btn-outline-primary btn-kep-sm"><i class="fas fa-edit"></i> Edit</button>
			<button type="button" class="btn btn-outline-danger btn-kep-sm kep-hapus-single"><i class="fas fa-trash"></i> Hapus</button>
		</div>
	</div>

	<ul class="nav kep-tabs kep-tabs-detail" role="tablist">
		<li class="nav-item"><a class="nav-link active" id="dp-profil-tab" data-toggle="tab" href="#dp-profil" role="tab"><i class="fas fa-user"></i> Profil</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-kepeg-tab" data-toggle="tab" href="#dp-kepeg" role="tab"><i class="fas fa-briefcase"></i> Kepegawaian</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-pdd-tab" data-toggle="tab" href="#dp-pdd" role="tab"><i class="fas fa-graduation-cap"></i> Pendidikan</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-pangkat-tab" data-toggle="tab" href="#dp-pangkat" role="tab"><i class="fas fa-award"></i> Riwayat Pangkat</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-jab-tab" data-toggle="tab" href="#dp-jab" role="tab"><i class="fas fa-id-badge"></i> Riwayat Jabatan</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-diklat-tab" data-toggle="tab" href="#dp-diklat" role="tab"><i class="fas fa-chalkboard-teacher"></i> Diklat</a></li>
		<li class="nav-item"><a class="nav-link" id="dp-doc-tab" data-toggle="tab" href="#dp-doc" role="tab"><i class="fas fa-folder-open"></i> Dokumen</a></li>
	</ul>

	<div class="tab-content kep-tab-content">
		<div class="tab-pane fade show active" id="dp-profil" role="tabpanel">
			<table class="tm-table kep-detail-table">
				<tbody>
					<% [['Nama Lengkap', p.nama], ['NIP', p.nip], ['NIK', p.nik], ['Tempat / Tgl Lahir', p.ttl], ['Jenis Kelamin', p.jk], ['Alamat', p.alamat], ['No. HP', p.hp], ['Email', p.email]].forEach(function (row) { %>
						<tr><td><%= row[0] %></td><td><%= row[1] %></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-kepeg" role="tabpanel">
			<table class="tm-table kep-detail-table">
				<tbody>
					<% [['Pangkat/Golongan', p.pangkat + ' — ' + p.golongan], ['Jabatan', p.jabatan], ['Status Kepegawaian', p.status], ['TMT', p.tmt], ['Unit Kerja', p.unit]].forEach(function (row) { %>
						<tr><td><%= row[0] %></td><td><%= row[1] %></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-pdd" role="tabpanel">
			<table class="tm-table kep-table">
				<thead><tr><th>No</th><th>Jenjang</th><th>Jurusan</th><th>Institusi</th><th>Tahun</th></tr></thead>
				<tbody>
					<% (p.pendidikan || []).forEach(function (r, i) { %>
						<tr><td class="kep-no"><%= i + 1 %></td><td><%= r.jenjang %></td><td><%= r.jurusan %></td><td><%= r.sekolah %></td><td><%= r.tahun %></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-pangkat" role="tabpanel">
			<table class="tm-table kep-table">
				<thead><tr><th>No</th><th>Pangkat</th><th>Golongan</th><th>TMT</th><th>No. SK</th></tr></thead>
				<tbody>
					<% (p.riwayatPangkat || []).forEach(function (r, i) { %>
						<tr><td class="kep-no"><%= i + 1 %></td><td><%= r.pangkat %></td><td><%= r.golongan %></td><td><%= r.tmt %></td><td><%= r.sk %></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-jab" role="tabpanel">
			<table class="tm-table kep-table">
				<thead><tr><th>No</th><th>Jabatan</th><th>Unit Kerja</th><th>TMT</th></tr></thead>
				<tbody>
					<% (p.riwayatJabatan || []).forEach(function (r, i) { %>
						<tr><td class="kep-no"><%= i + 1 %></td><td><%= r.jabatan %></td><td><%= r.unit %></td><td><%= r.tmt %></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-diklat" role="tabpanel">
			<table class="tm-table kep-table">
				<thead><tr><th>No</th><th>Nama Diklat</th><th>Tahun</th><th>Status</th></tr></thead>
				<tbody>
					<% (p.diklat || []).forEach(function (r, i) { %>
						<tr><td class="kep-no"><%= i + 1 %></td><td><%= r.nama %></td><td><%= r.tahun %></td><td><span class="kep-badge kb-green"><%= r.status %></span></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>
		<div class="tab-pane fade" id="dp-doc" role="tabpanel">
			<table class="tm-table kep-table">
				<thead><tr><th>No</th><th>Nama Dokumen</th><th>Jenis</th><th>Status</th></tr></thead>
				<tbody>
					<% (p.dokumen || []).forEach(function (r, i) { %>
						<tr><td class="kep-no"><%= i + 1 %></td><td><%= r.nama %></td><td><%= r.jenis %></td><td><span class="kep-badge kb-blue"><%= r.status %></span></td></tr>
					<% }) %>
				</tbody>
			</table>
		</div>
	</div>
</div>
