<nav class="navbar navbar-expand-lg tm-navbar">
	<a class="navbar-brand" href="/?hal=home">
		<img src="/images/logokab.png" class="tm-brand-logo" alt="Logo" /> Timker Kepegawaian
	</a>
	<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#tm-navbar" aria-controls="tm-navbar" aria-expanded="false" aria-label="Menu navigasi">
		<span class="navbar-toggler-icon"></span>
	</button>
	<div class="collapse navbar-collapse" id="tm-navbar">
		<ul class="navbar-nav mr-auto">
			<%
			function menuIcon(m) {
				return '<i class="fas ' + (m.icon || 'fa-folder-open') + '"></i>';
			}
			function menuLeaf(item) {
				return '<a class="dropdown-item" href="' + (item.url || '#') + '">' + menuIcon(item) + ' ' + item.label + '</a>';
			}
			function menuItems(items) {
				var out = '';
				(items || []).forEach(function (c) {
					if (c.children && c.children.length) {
						out += '<div class="dropdown-submenu"><a class="dropdown-item dropdown-toggle" href="#">' + menuIcon(c) + ' ' + c.label + '</a><div class="dropdown-menu">' + menuItems(c.children) + '</div></div>';
					} else {
						out += menuLeaf(c);
					}
				});
				return out;
			}
			function menuTree(m) {
				if (m.children && m.children.length) {
					return '<li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="navMenu' + m.id + '" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">' + menuIcon(m) + ' ' + m.label + '</a><div class="dropdown-menu">' + menuItems(m.children) + '</div></li>';
				}
				return '<li class="nav-item"><a class="nav-link" href="' + (m.url || '#') + '">' + menuIcon(m) + ' ' + m.label + '</a></li>';
			}
			%>
			<% (menus || []).forEach(function (m) { %><%- menuTree(m) %><% }) %>
		</ul>
		<style>
			.dropdown-submenu { position: relative; }
			.dropdown-submenu > .dropdown-menu { top: 0; left: 100%; margin-top: -6px; margin-left: -1px; border-radius: 0 6px 6px 6px; }
			.dropdown-submenu > a.dropdown-item.dropdown-toggle::after { transform: rotate(-90deg); }
			.dropdown-submenu:hover > .dropdown-menu { display: block; }
		</style>
		<% if (member) { %>
			<form class="form-inline my-2 my-lg-0 tm-search-form" action="/" method="GET">
				<input name="nama" class="form-control mr-sm-2 tm-search" type="text" placeholder="Cari pegawai..." aria-label="Cari pegawai">
				<button class="btn tm-search-btn my-2 my-sm-0" type="submit">
					<i class="fas fa-search"></i>
				</button>
				<input type="hidden" name="hal" value="pegawai" />
			</form>
		<% } %>
		<ul class="navbar-nav ml-lg-auto">
			<% if (!member) { %>
				<li class="nav-item">
					<a class="nav-link" href="#" data-toggle="modal" data-target="#tmLoginModal"><i class="fas fa-sign-in-alt"></i> Login</a>
				</li>
			<% } else { %>
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navUser" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
						<% if (!member.foto) { %>
							<img src="/images/no_photo.png" class="tm-avatar" alt="avatar" />
						<% } else if (member.foto.indexOf('http') === 0) { %>
							<img src="<%= member.foto %>" class="tm-avatar" alt="avatar" />
						<% } else { %>
							<img src="/images/<%= member.foto %>" class="tm-avatar" alt="avatar" />
						<% } %>
						<span class="tm-user-name"><%= member.fullname %></span>
					</a>
					<div class="dropdown-menu dropdown-menu-right" aria-labelledby="navUser">
						<div class="tm-user-head">
							<div class="tm-user-head-name"><%= member.fullname %></div>
							<% var roleBadgeMap = { administrator: 'admin', staff: 'staff' }; %>
							<span class="badge-tm badge-role-<%= roleBadgeMap[member.role] || member.role %>"><%= member.role %></span>
						</div>
						<div class="dropdown-divider"></div>
						<a class="dropdown-item" href="/?hal=profile&id=<%= member.id %>"><i class="fas fa-id-card"></i> Profile</a>
						<div class="dropdown-divider"></div>
						<a class="dropdown-item" href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
					</div>
				</li>
			<% } %>
		</ul>
	</div>
</nav>

<script>
(function () {
	var path = location.pathname;
	var full = path + location.search;
	var links = document.querySelectorAll('#tm-navbar a.nav-link, #tm-navbar a.dropdown-item');
	var found = null;
	links.forEach(function (a) {
		var href = a.getAttribute('href');
		if (href && href !== '#' && href === full) {
			a.classList.add('active');
			found = a;
		}
	});
	if (!found) {
		links.forEach(function (a) {
			var href = a.getAttribute('href');
			if (href && href !== '#' && href.indexOf('?') === -1 && href.length > 1 && path.indexOf(href) === 0) {
				a.classList.add('active');
				found = a;
			}
		});
	}
	if (found) {
		var dd = found.closest('.dropdown');
		if (dd) {
			var toggle = dd.querySelector('.dropdown-toggle');
			if (toggle) toggle.classList.add('active');
		}
	}
})();
</script>
