<nav class="navbar navbar-expand-lg tm-navbar">
	<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#tm-navbar">
		<span class="navbar-toggler-icon"></span>
	</button>
	<a class="navbar-brand" href="/?hal=home">
		<img src="/images/logokab.png" class="tm-brand-logo" alt="Logo" /> Timker Kepegawaian
	</a>
	<div class="collapse navbar-collapse" id="tm-navbar">
		<ul class="navbar-nav mr-auto">
			<li class="nav-item active">
				<a class="nav-link" href="/?hal=home"><i class="fas fa-home"></i> Home</a>
			</li>
			<li class="nav-item">
				<a class="nav-link" href="/?hal=aboutus"><i class="fas fa-address-book"></i> Tentang Kami</a>
			</li>
		</ul>
		<% if (member) { %>
			<form class="form-inline my-2 my-lg-0" action="/" method="GET">
				<input name="nama" class="form-control mr-sm-2 tm-search" type="text" placeholder="Cari pegawai..." aria-label="Cari pegawai">
				<button class="btn tm-search-btn my-2 my-sm-0" type="submit">
					<i class="fas fa-search"></i>
				</button>
				<input type="hidden" name="hal" value="pegawai" />
			</form>
		<% } %>
		<ul class="navbar-nav ml-lg-auto">
			<% if (!member) { %>
				<li class="nav-item active">
					<a class="nav-link" href="#" data-toggle="modal" data-target="#tmLoginModal"><i class="fas fa-sign-in-alt"></i> Login</a>
				</li>
			<% } else { %>
				<li class="nav-item dropdown">
					<a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navUser" data-toggle="dropdown">
						<% if (!member.foto) { %>
							<img src="/images/no_photo.png" class="tm-avatar" alt="avatar" />
						<% } else { %>
							<img src="/images/<%= member.foto %>" class="tm-avatar" alt="avatar" />
						<% } %>
						<span>Hello, <%= member.fullname %></span>
					</a>
					<div class="dropdown-menu dropdown-menu-right" aria-labelledby="navUser">
						<a class="dropdown-item" href="/?hal=profile&id=<%= member.id %>"><i class="fas fa-id-card"></i> Profile</a>
						<% if (member.role == 'administrator') { %>
							<a class="dropdown-item" href="/?hal=kelolaUser"><i class="fas fa-user-cog"></i> Kelola User</a>
						<% } %>
						<div class="dropdown-divider"></div>
						<a class="dropdown-item" href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
					</div>
				</li>
			<% } %>
		</ul>
	</div>
</nav>
