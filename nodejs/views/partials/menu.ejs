<script>
(function () {
	var path = location.pathname;
	var items = document.querySelectorAll('#tm-navbar .dropdown-menu a.dropdown-item');
	var found = null;
	items.forEach(function (a) {
		if (a.getAttribute('href') === path) {
			a.classList.add('active');
			found = a;
		}
	});
	if (found) {
		var dd = found.closest('.dropdown-toggle');
		if (dd) dd.classList.add('active');
	}
})();
</script>
