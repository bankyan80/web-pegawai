<script>
(function () {
	var nav = document.querySelector('.kep-nav');
	if (!nav) return;
	var items = nav.querySelectorAll('.kep-menu-item');
	var btns = nav.querySelectorAll('.kep-menu-btn[aria-haspopup]');

	function closeAll(except) {
		items.forEach(function (item) {
			if (item === except) return;
			item.classList.remove('open');
			var btn = item.querySelector('.kep-menu-btn');
			if (btn) btn.setAttribute('aria-expanded', 'false');
		});
	}

	btns.forEach(function (btn) {
		btn.addEventListener('click', function (e) {
			e.stopPropagation();
			var item = btn.closest('.kep-menu-item');
			var isOpen = item.classList.contains('open');
			closeAll(item);
			if (!isOpen) {
				item.classList.add('open');
				btn.setAttribute('aria-expanded', 'true');
			} else {
				btn.setAttribute('aria-expanded', 'false');
			}
		});
	});

	nav.addEventListener('click', function (e) {
		var link = e.target.closest('.kep-dropdown-item');
		if (!link) return;
		nav.querySelectorAll('.kep-dropdown-item').forEach(function (a) {
			a.classList.remove('active');
		});
		link.classList.add('active');
		try {
			localStorage.setItem('kepMenuAktif', link.getAttribute('href'));
		} catch (err) {}
		closeAll();
	});

	document.addEventListener('click', function () { closeAll(); });
	document.addEventListener('keydown', function (e) {
		if (e.key === 'Escape') closeAll();
	});

	(function initActive() {
		var path = location.pathname;
		var stored = null;
		try { stored = localStorage.getItem('kepMenuAktif'); } catch (err) {}
		var target = stored === path ? stored : null;
		nav.querySelectorAll('.kep-dropdown-item').forEach(function (a) {
			if (a.getAttribute('href') === path) a.classList.add('active');
			else if (target && a.getAttribute('href') === target) a.classList.add('active');
		});
	})();
})();
</script>
