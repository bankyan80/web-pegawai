<!DOCTYPE html>
<html lang="id">

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Tech Muda 4 | Sistem Kepegawaian</title>

	<meta name="description" content="Sistem informasi kepegawaian Tech Muda 4">
	<meta name="author" content="Tech Muda 4">

	<link href="/css/bootstrap.min.css" rel="stylesheet">
	<link href="/fontawesome/css/all.css" rel="stylesheet">
	<link href="/css/theme.css" rel="stylesheet">
	<link href="/images/statistics.png" rel="icon" />

</head>

<body>

	<%- include('partials/menu') %>
	<% if (member) { %><%- include('partials/menu_kepegawaian') %><% } %>

	<div class="container-fluid main-wrapper">
		<div class="row">
			<% if (member) { %>
				<div class="col-lg-9 content-col order-1 order-lg-2">
					<div class="page-card">
						<%- body %>
					</div>
				</div>
				<div class="col-lg-3 sidebar-col order-2 order-lg-1">
					<%- include('partials/sidebar') %>
				</div>
			<% } else { %>
				<div class="col-12 content-col">
					<div class="page-card">
						<%- body %>
					</div>
				</div>
			<% } %>
		</div>
	</div>

	<% if (!member) { %>
	<div class="modal fade" id="tmLoginModal" tabindex="-1" role="dialog" aria-labelledby="tmLoginModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="tmLoginModalLabel"><i class="fas fa-sign-in-alt mr-1"></i> Login</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body">
					<form method="POST" action="/controller/login">
						<input type="hidden" name="csrf_token" value="<%= csrf %>">
						<div class="form-group">
							<label>Username</label>
							<input type="text" class="form-control" name="username">
						</div>
						<div class="form-group">
							<label>Password</label>
							<input type="password" class="form-control" name="password">
						</div>
						<button type="submit" class="btn btn-primary btn-block"><i class="fas fa-sign-in-alt mr-1"></i> Login</button>
					</form>
				</div>
			</div>
		</div>
	</div>
	<% } %>

	<script src="/js/jquery.min.js"></script>
	<script src="/js/popper.min.js"></script>
	<script src="/js/bootstrap.min.js"></script>
	<script src="/js/kep.js"></script>
</body>

</html>
