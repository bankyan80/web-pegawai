# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# File ".env" TIDAK boleh di-commit (sudah dilindungi .gitignore & .dockerignore).

# --- DATABASE (SUPABASE) ---
# URL proyek Supabase Anda (Settings > API > Project URL)
SUPABASE_URL=https://xxxx.supabase.co

# Service Role Key (Settings > API > Service Role). RAHASIA — hanya dipakai server.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- APLIKASI ---
# Secret sesi (wajib diganti nilai acak untuk produksi):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-secret-panjang-acak

# Port server (default 3000)
PORT=3000

# --- CLOUDFLARE AI (opsional, untuk Analisis Data & Audit) ---
# Account ID Cloudflare (dari dashboard Cloudflare)
CLOUDFLARE_ACCOUNT_ID=

# API Token Cloudflare dengan izin AI
CLOUDFLARE_API_TOKEN=

# Model AI (opsional)
# CLOUDFLARE_MODEL_ID=@cf/meta/llama-3.1-8b-instruct

# --- DEBUG ---
# Mode debug (1 = development). Produksi set 0 & NODE_ENV=production.
APP_DEBUG=0
NODE_ENV=production
