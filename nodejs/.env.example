# Salin file ini menjadi ".env" lalu sesuaikan nilainya.
# Jika ".env" tidak ada, aplikasi memakai nilai default (SQLite di nodejs/database.sqlite).

# --- DATABASE ---
# Tanpa instalasi apa pun (default): database file SQLite via modul bawaan Node.js.
# Lokasi file database (opsional, default: database.sqlite di folder nodejs)
# DB_FILE=C:\path\ke\database.sqlite

# (Opsional) Jika ingin memakai server MySQL: atur variabel di bawah.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=dbtechmuda42

# --- APLIKASI ---
# Secret untuk sesi (wajib diganti dengan nilai acak pada produksi)
SESSION_SECRET=ganti-dengan-secret-panjang-acak

# Port server (default 3000)
PORT=3000

# --- CLOUDFLARE AI (untuk Analisis Data & Audit) ---
# Account ID Cloudflare (ambil dari dashboard Cloudflare)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# API Token Cloudflare dengan izin AI (buat di dashboard)
CLOUDFLARE_API_TOKEN=your_api_token_here

# Model ID untuk AI (default: @cf/meta/llama-2-7b-chat-int8)
# CLOUDFLARE_MODEL_ID=@cf/meta/llama-2-7b-chat-int8

# --- DEBUG ---
# Mode debug (set ke 1 untuk development)
APP_DEBUG=1
NODE_ENV=development
